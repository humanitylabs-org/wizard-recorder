          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "configured": {
                      "type": "boolean"
                    },
                    "delivered": {
                      "type": "integer"
                    },
                    "waiting": {
                      "type": "integer"
                    },
                    "last_error": {
                      "type": "string"
                    }
                  }
                }
